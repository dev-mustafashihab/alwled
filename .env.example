# Alwled backend — environment template (no real secrets)

DATABASE_URL=postgresql://user:password@localhost:5432/alwled?schema=public
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3100
NODE_ENV=development
CORS_ORIGINS=

# Reverse proxy hops to trust for the real client IP (rate limiting / audit).
# Leave empty for direct exposure; set to 1 behind nginx.
TRUST_PROXY=http://localhost:5173

SEED_OWNER_PHONE=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=

# Password reset / verification token lifetimes (minutes)
PASSWORD_RESET_TTL_MINUTES=30
VERIFICATION_TTL_MINUTES=15

# Rate limits (window in seconds, max requests)
RATE_GLOBAL_MAX=240
RATE_REGISTER_WINDOW=3600
RATE_REGISTER_MAX=10
RATE_LOGIN_WINDOW=300
RATE_LOGIN_MAX=20
RATE_FORGOT_WINDOW=900
RATE_FORGOT_MAX=5
RATE_RESET_WINDOW=900
RATE_RESET_MAX=10
RATE_RESEND_WINDOW=300
RATE_RESEND_MAX=3
RATE_REFRESH_WINDOW=300
RATE_REFRESH_MAX=60

# Manual Sham Cash receiving account (no API integration, no credentials).
# Shown to customers so they can transfer; leave empty to keep the flow unconfigured.
SHAMCASH_WALLET_NUMBER=
SHAMCASH_ACCOUNT_NAME=
SHAMCASH_INSTRUCTIONS=
SHAMCASH_CURRENCY=USD

# --- Stage 9: customer verification -------------------------------------------
# Only LOG is a valid value today. Any other value makes the app fail fast on boot
# (no silent fallback). No API key / secret / provider URL exists at this stage.
VERIFICATION_PROVIDER=LOG
# How long a request stays active before it is treated as EXPIRED (lazy expiry).
VERIFICATION_REQUEST_TTL_HOURS=72
# Rate limits for the customer endpoints (window seconds / max requests).
RATE_VERIFICATION_START_WINDOW=900
RATE_VERIFICATION_START_MAX=10
RATE_VERIFICATION_CANCEL_WINDOW=900
RATE_VERIFICATION_CANCEL_MAX=10

# --- Stage 11: notifications ---------------------------------------------------
# Only IN_APP is a valid value today (no e-mail/SMS/push provider exists).
# An unknown value makes the app fail fast on boot — no silent fallback.
NOTIFICATION_PROVIDER=IN_APP
RATE_NOTIFICATIONS_WINDOW=900
RATE_NOTIFICATIONS_MAX=30
