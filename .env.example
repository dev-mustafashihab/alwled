# Alwled backend — environment template (no real secrets)

DATABASE_URL=postgresql://user:password@localhost:5432/alwled?schema=public
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
PORT=3100
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173

SEED_OWNER_PHONE=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=

# Password reset / verification token lifetimes (minutes)
PASSWORD_RESET_TTL_MINUTES=30
VERIFICATION_TTL_MINUTES=15

# Rate limits (window in seconds, max requests)
RATE_GLOBAL_MAX=240
RATE_REGISTER_WINDOW=3600
RATE_REGISTER_MAX=10
RATE_LOGIN_WINDOW=300
RATE_LOGIN_MAX=20
RATE_FORGOT_WINDOW=900
RATE_FORGOT_MAX=5
RATE_RESET_WINDOW=900
RATE_RESET_MAX=10
RATE_RESEND_WINDOW=300
RATE_RESEND_MAX=3
RATE_REFRESH_WINDOW=300
RATE_REFRESH_MAX=60
