# Alwled backend — environment template (بقيم placeholder فقط، بلا أي سرّ حقيقي)
# لا تنسخ هذا الملف إلى Git بقيم حقيقية. الأسرار تُمرَّر من environment أو secret manager.

# --- Runtime ------------------------------------------------------------------
NODE_ENV=production
PORT=3100
# عدد قفزات الـproxy الموثوقة لقراءة IP الحقيقي (rate limiting/audit). 1 خلف nginx، فارغ عند التعرض المباشر.
TRUST_PROXY=1
# أصل الواجهة المسموح للـCORS (قائمة مفصولة بفواصل). اتركه فارغاً إذا كان التقديم من نفس الأصل.
CORS_ORIGINS=
# Swagger: معطّل تلقائياً في production إلا إذا صار 'true' صراحةً (dev يبقى مفعّلاً دائماً).
SWAGGER_ENABLED=false
# تسجيل أحداث سلة العميل في سجل التدقيق (اختياري).
AUDIT_CART_EVENTS=false

# --- Database -----------------------------------------------------------------
# مثال الشكل فقط — استبدل user/password/host/db بقيمك من سرّ خارجي.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public

# --- Secrets (إلزامية في production، 32 حرفاً على الأقل، لا قيم placeholder) -----
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Seed (يُستخدم مرة عند التهيئة الأولى) --------------------------------------
SEED_OWNER_PHONE=
SEED_OWNER_PASSWORD=
SEED_OWNER_EMAIL=

# --- Token lifetimes (minutes) --------------------------------------------------
PASSWORD_RESET_TTL_MINUTES=30
VERIFICATION_TTL_MINUTES=15

# --- Rate limits (نافذة بالثواني / حد أقصى للطلبات) ------------------------------
RATE_GLOBAL_MAX=240
RATE_REGISTER_WINDOW=3600
RATE_REGISTER_MAX=10
RATE_LOGIN_WINDOW=300
RATE_LOGIN_MAX=20
RATE_FORGOT_WINDOW=900
RATE_FORGOT_MAX=5
RATE_RESET_WINDOW=900
RATE_RESET_MAX=10
RATE_RESEND_WINDOW=300
RATE_RESEND_MAX=3
RATE_REFRESH_WINDOW=300
RATE_REFRESH_MAX=60
RATE_ORDERS_WINDOW=300
RATE_ORDERS_MAX=30
RATE_PAYMENT_CREATE_WINDOW=600
RATE_PAYMENT_CREATE_MAX=20
RATE_PAYMENT_SUBMIT_WINDOW=900
RATE_PAYMENT_SUBMIT_MAX=10
RATE_NOTIFICATIONS_WINDOW=900
RATE_NOTIFICATIONS_MAX=30
RATE_VERIFICATION_START_WINDOW=900
RATE_VERIFICATION_START_MAX=10
RATE_VERIFICATION_CANCEL_WINDOW=900
RATE_VERIFICATION_CANCEL_MAX=10

# --- Sham Cash (دفع يدوي — لا API ولا مفاتيح ولا مزوّد) --------------------------
# اتركها فارغة لتبقى الحالة configured=false (لا اختراع لبيانات محفظة).
SHAMCASH_WALLET_NUMBER=
SHAMCASH_ACCOUNT_NAME=
SHAMCASH_INSTRUCTIONS=
SHAMCASH_CURRENCY=USD

# --- Customer verification (Stage 9: LOG فقط — لا مزوّد خارجي) -------------------
# أي قيمة غير LOG تُفشل الإقلاع صراحةً (لا fallback صامت).
VERIFICATION_PROVIDER=LOG
VERIFICATION_REQUEST_TTL_HOURS=72

# --- Notifications (Stage 11: IN_APP فقط — لا SMS/Email/Push) --------------------
# أي قيمة غير IN_APP تُفشل الإقلاع صراحةً.
NOTIFICATION_PROVIDER=IN_APP

# --- Docker compose (لتهيئة حاوية قاعدة البيانات فقط) ---------------------------
POSTGRES_USER=alwled
POSTGRES_PASSWORD=
POSTGRES_DB=alwled
