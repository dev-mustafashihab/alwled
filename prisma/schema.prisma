// Alwled — Stage 4: Catalog (categories, brands, products, images, specs) + Inventory foundation
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum RefreshStatus {
  ACTIVE
  USED
  REVOKED
}

enum VerificationChannel {
  EMAIL
  SMS
  WHATSAPP
  OTP
}

/// Stage 4 — how a specification value must be validated/displayed.
enum SpecificationType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
}

/// Stage 6 — order lifecycle. No payment-specific states exist in this stage.
enum OrderStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

/// Stage 4 — stock movement types. RESERVATION/RELEASE/SALE/RETURN are reserved
/// for the orders stage; the model already supports them.
enum InventoryMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RESERVATION
  RELEASE
  SALE
  RETURN
}

model User {
  id           String     @id @default(cuid())
  firstName    String     @map("first_name")
  lastName     String     @map("last_name")
  email        String?    @unique
  phone        String?    @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  isVerified   Boolean    @default(false) @map("is_verified")
  lastLoginAt  DateTime?  @map("last_login_at")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  deletedAt    DateTime?  @map("deleted_at")

  roles               UserRole[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  verificationTokens  VerificationToken[]
  auditLogs           AuditLog[]
  inventoryMovements  InventoryMovement[]
  cart                Cart?
  orders              Order[]
  idempotencyKeys     IdempotencyKey[]

  @@index([status])
  @@index([createdAt])
  @@index([isVerified])
  @@map("users")
}

/// name is a plain string so custom roles (SALES, PRODUCT_MANAGER, ...) need no schema change.
/// System roles are protected by isSystem = true.
model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       UserRole[]
  permissions RolePermission[]

  @@index([isSystem])
  @@map("roles")
}

model UserRole {
  userId     String   @map("user_id")
  roleId     Int      @map("role_id")
  assignedAt DateTime @default(now()) @map("assigned_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Permission {
  id        Int      @id @default(autoincrement())
  key       String   @unique
  name      String
  group     String
  createdAt DateTime @default(now()) @map("created_at")

  roles RolePermission[]

  @@index([group])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

/// One row = one device/session. Token itself is never stored in clear text.
model RefreshToken {
  id                  String        @id @default(cuid())
  sessionId           String        @unique @default(cuid()) @map("session_id")
  userId              String        @map("user_id")
  tokenHash           String        @unique @map("token_hash")
  status              RefreshStatus @default(ACTIVE)
  replacedBySessionId String?       @map("replaced_by_session_id")
  expiresAt           DateTime      @map("expires_at")
  revokedAt           DateTime?     @map("revoked_at")
  userAgent           String?       @map("user_agent")
  ip                  String?
  createdAt           DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Provider-agnostic verification foundation (SMS / Email / WhatsApp / OTP later).
model VerificationToken {
  id          String              @id @default(cuid())
  userId      String              @map("user_id")
  tokenHash   String              @unique @map("token_hash")
  channel     VerificationChannel @default(OTP)
  destination String?
  expiresAt   DateTime            @map("expires_at")
  usedAt      DateTime?           @map("used_at")
  attempts    Int                 @default(0)
  createdAt   DateTime            @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("verification_tokens")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?  @map("actor_id")
  action    String
  entity    String?
  entityId  String?  @map("entity_id")
  metadata  Json?
  ip        String?
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([action])
  @@index([createdAt])
  @@index([entity, entityId])
  @@map("audit_logs")
}

/// ------------------------- Stage 4: Catalog -------------------------

/// Self-referencing tree (parent → children). Depth limited in the service layer;
/// no closure table needed for a storefront catalog.
model Category {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  description String?
  image       String?
  parentId    Int?     @map("parent_id")
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[] @relation("CategoryTree")

  products          Product[]
  specifications    SpecificationDefinition[]

  @@index([parentId])
  @@index([isActive])
  @@index([sortOrder])
  @@map("categories")
}

model Brand {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  logo        String?
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  products Product[]

  @@index([isActive])
  @@map("brands")
}

/// Money is NUMERIC(12,2) — never float. Serialized as a string in API responses.
model Product {
  id               Int      @id @default(autoincrement())
  name             String
  slug             String   @unique
  sku              String   @unique
  shortDescription String?  @map("short_description")
  description      String?
  price            Decimal  @db.Decimal(12, 2)
  compareAtPrice   Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  brandId          Int      @map("brand_id")
  categoryId       Int      @map("category_id")
  isActive         Boolean  @default(true) @map("is_active")
  isFeatured       Boolean  @default(false) @map("is_featured")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  /// Restrict (not Cascade): a brand/category used by products cannot be deleted.
  brand    Brand    @relation(fields: [brandId], references: [id], onDelete: Restrict)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  images         ProductImage[]
  specifications ProductSpecification[]
  inventory      Inventory?
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([price])
  @@map("products")
}

model ProductImage {
  id        Int      @id @default(autoincrement())
  productId Int      @map("product_id")
  url       String
  altText   String?  @map("alt_text")
  sortOrder Int      @default(0) @map("sort_order")
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

/// Reusable specification catalogue: Capacity (NUMBER, L), Color (SELECT), No Frost (BOOLEAN)...
/// Adding a new spec never touches the Product table.
model SpecificationDefinition {
  id          Int               @id @default(autoincrement())
  name        String
  key         String            @unique
  type        SpecificationType @default(TEXT)
  unit        String?
  options     String[]          @default([])
  categoryId  Int?              @map("category_id")
  isActive    Boolean           @default(true) @map("is_active")
  sortOrder   Int               @default(0) @map("sort_order")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  category Category?              @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  values   ProductSpecification[]

  @@index([isActive])
  @@index([categoryId])
  @@map("specification_definitions")
}

/// Only the scalar value is stored; the unit lives on the definition.
model ProductSpecification {
  id            Int      @id @default(autoincrement())
  productId     Int      @map("product_id")
  specificationId Int    @map("specification_id")
  value         String
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  specification SpecificationDefinition @relation(fields: [specificationId], references: [id], onDelete: Restrict)

  @@unique([productId, specificationId])
  @@index([specificationId])
  @@map("product_specifications")
}

/// One inventory row per product. availableQuantity is ALWAYS computed
/// (quantity - reservedQuantity) and never stored, so it cannot drift.
model Inventory {
  id                Int      @id @default(autoincrement())
  productId         Int      @unique @map("product_id")
  quantity          Int      @default(0)
  reservedQuantity  Int      @default(0) @map("reserved_quantity")
  lowStockThreshold Int      @default(5) @map("low_stock_threshold")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  product   Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  movements InventoryMovement[]

  @@index([quantity])
  @@map("inventory")
}

model InventoryMovement {
  id            Int                   @id @default(autoincrement())
  inventoryId   Int                   @map("inventory_id")
  type          InventoryMovementType
  quantity      Int                   /// signed delta applied to `quantity`
  reason        String?
  referenceType String?               @map("reference_type")
  referenceId   String?               @map("reference_id")
  createdBy     String?               @map("created_by")
  createdAt     DateTime              @default(now()) @map("created_at")

  inventory Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  actor     User?     @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([inventoryId, createdAt])
  @@index([type])
  @@map("inventory_movements")
}

/// ------------------------- Stage 5: Cart -------------------------
/// One active cart per user (userId is unique). Cart is "intent" only:
/// it never reserves inventory and never stores prices as a source of truth.
model Cart {
  id        Int      @id @default(autoincrement())
  userId    String   @unique @map("user_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@index([userId])
  @@map("carts")
}

model CartItem {
  id        Int      @id @default(autoincrement())
  cartId    Int      @map("cart_id")
  productId Int      @map("product_id")
  quantity  Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  /// Cascade is safe here: a cart line is transient intent, not financial history.
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@index([cartId])
  @@index([productId])
  @@map("cart_items")
}

/// ------------------------- Stage 6: Orders -------------------------
/// An order is an immutable historical snapshot: product name/SKU/slug/image and
/// unit prices are copied at creation time and never re-read from Product.
model Order {
  id                 Int         @id @default(autoincrement())
  orderNumber        String      @unique @map("order_number")
  userId             String      @map("user_id")
  status             OrderStatus @default(PENDING)
  subtotal           Decimal     @db.Decimal(12, 2)
  shippingAmount     Decimal     @default(0) @map("shipping_amount") @db.Decimal(12, 2)
  discountAmount     Decimal     @default(0) @map("discount_amount") @db.Decimal(12, 2)
  total              Decimal     @db.Decimal(12, 2)
  currency           String      @default("USD")
  cancelledAt        DateTime?   @map("cancelled_at")
  cancellationReason String?     @map("cancellation_reason")
  createdAt          DateTime    @default(now()) @map("created_at")
  updatedAt          DateTime    @updatedAt @map("updated_at")

  /// Restrict: a user with orders cannot be hard-deleted (keep financial history).
  user  User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  items OrderItem[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id           Int      @id @default(autoincrement())
  orderId      Int      @map("order_id")
  /// Nullable so history survives a hard product delete (ON DELETE SET NULL).
  productId    Int?     @map("product_id")
  productName  String   @map("product_name")
  productSku   String   @map("product_sku")
  productSlug  String?  @map("product_slug")
  productImage String?  @map("product_image")
  unitPrice    Decimal  @map("unit_price") @db.Decimal(12, 2)
  quantity     Int
  lineSubtotal Decimal  @map("line_subtotal") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

/// Idempotency guard for POST /orders: unique (userId, key) inside the same
/// transaction as the order, so a double submit can never create two orders.
model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  key         String
  requestHash String   @map("request_hash")
  orderId     Int?     @map("order_id")
  statusCode  Int?     @map("status_code")
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
  @@map("idempotency_keys")
}
