   "html": "<article class=\"ds-card\"><div class=\"ds-card__media\"><span class=\"ds-card__flag\">-16.67%</span></div><div class=\"ds-card__body\"><span class=\"ds-card__brand\">علامة تجريبية ب</span><h3 class=\"ds-card__name\">منتج تجريبي — ثلاجة 300 لتر</h3><div class=\"ds-card__price\"><span class=\"ds-card__now\">$350.00</span></div><button class=\"ds-card__add\">أضف للسلة</button></div></article>",
